# LegalSense environment variables — example only
# Copy to .env and fill in real values where needed.

# Optional: Groq API key (not required for Phase 1 or core WSD operation)
GROQ_API_KEY=
GROQ_MODEL=

# Optional: upload size limit in MB
LEGAL_SENSE_MAX_UPLOAD_MB=5

# Optional: enable LLM assistance (default: false)
LEGAL_SENSE_ENABLE_LLM=false
